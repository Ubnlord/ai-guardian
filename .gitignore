# Dependencies
node_modules/
.pnpm-store/

# Build output — never committed. CI builds it and uploads `.vercel/output` as an
# artifact; `vercel deploy --prebuilt` ships that artifact (see
# .github/workflows/ci-cd.yml). Committing it instead means every build rewrites
# ~180 content-hashed filenames, producing enormous no-op diffs.
dist/
.output/
.vercel/
.nitro/
.tanstack/tmp/

# Environment — never commit secrets. The platform injects these at deploy.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Local scratch
.grok/preview.log
.grok/status
