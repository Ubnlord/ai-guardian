{
  "manifest_version": 3,
  "name": "AI Guardian — check this page",
  "version": "1.0.0",
  "description": "One click checks the page you are on for scam, phishing, and impersonation risk. Score, verdict, and the reasons — before you click, pay, or reply.",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Check this page with AI Guardian",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications"],
  "host_permissions": ["http://localhost/*", "https://*/*"],
  "optional_host_permissions": ["http://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Check the current page with AI Guardian"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "guardian@ai-guardian.app",
      "strict_min_version": "121.0"
    }
  }
}
